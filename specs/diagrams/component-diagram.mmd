flowchart TB
    subgraph Cliente
        FE[Aplicación web frontend]
    end

    subgraph Backend
        API[Controladores HTTP API]
        APP[Casos de uso de aplicación]
        DOMAIN[Modelo de dominio]
        PORTS[Puertos]
    end

    subgraph Adaptadores
        NEURON[Adaptador Neuron/Konami]
        YGO[Adaptador YGOPRODeck]
        RENDER[Adaptador de renderizado de imagen]
        STORAGE[Adaptador de almacenamiento de archivos e imágenes]
        REPOS[Repositorios PostgreSQL]
    end

    DB[(PostgreSQL)]
    EXT_YGO[API YGOPRODeck]
    EXT_NEURON[Yu-Gi-Oh! Neuron / Konami DB]

    FE --> API
    API --> APP
    APP --> DOMAIN
    APP --> PORTS
    PORTS --> NEURON
    PORTS --> YGO
    PORTS --> RENDER
    PORTS --> STORAGE
    PORTS --> REPOS
    REPOS --> DB
    YGO --> EXT_YGO
    NEURON --> EXT_NEURON
